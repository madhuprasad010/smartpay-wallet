# ============================================================
# SmartPay — Digital Banking & Wallet Management System
# Master Environment Variables (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env for local Docker Compose execution.
# For Cloud Deployment (Render, TiDB, Upstash, Aiven, CloudAMQP),
# configure these variables directly in the provider's dashboard.
# NEVER commit the actual .env file with real credentials to GitHub.
# ============================================================

# ------------------------------------------------------------
# 1. CORE APPLICATION & NETWORKING
# ------------------------------------------------------------
APP_ENV=local
PORT=8080
SERVER_PORT=8080
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8080/api/v1
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------
# 2. RELATIONAL DATABASE (MySQL 8.4 Local / TiDB Cloud Starter)
#
# Dashboard Mapping:
# - TiDB Cloud: Clusters -> Connect -> Connect with SQL Client / General Connection
# ------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smartpay
DB_USER=smartpay
DB_PASSWORD=changeme_secure_db_password
DATABASE_SSL_MODE=false

# TiDB Cloud Starter Connection URL (Leave empty for local Docker Compose)
# Example: jdbc:mysql://gateway01.ap-south-1.prod.aws.tidbcloud.com:4000/smartpay?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=UTC
TIDB_DATABASE_URL=
TIDB_USER=
TIDB_PASSWORD=

# ------------------------------------------------------------
# 3. DISTRIBUTED CACHING (Redis 7 Local / Upstash Redis Free)
#
# Dashboard Mapping:
# - Upstash Console: Databases -> Details -> Connect -> Node/Java / rediss:// URL
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# Upstash TLS Connection URL (Leave empty for local Docker Compose)
# Example: rediss://default:YOUR_UPSTASH_PASSWORD@apn1-distinct-catfish-33451.upstash.io:6379
UPSTASH_REDIS_URL=

# ------------------------------------------------------------
# 4. EVENT STREAMING (Apache Kafka KRaft / Aiven Kafka Free)
#
# Dashboard Mapping:
# - Aiven Console: Services -> Kafka -> Overview -> Service URI & Authentication
# ------------------------------------------------------------
SMARTPAY_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=
KAFKA_PASSWORD=

# ------------------------------------------------------------
# 5. ASYNCHRONOUS MESSAGE QUEUE (RabbitMQ / CloudAMQP Free Tier)
#
# Dashboard Mapping:
# - CloudAMQP Console: Instances -> Details -> AMQP URL
# ------------------------------------------------------------
SMARTPAY_RABBITMQ_ENABLED=false
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=smartpay
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq_password
RABBITMQ_URL=amqp://smartpay:changeme_rabbitmq_password@rabbitmq:5672

# ------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY (JWT Token Keys)
#
# Generate a secure 256-bit key via:
# openssl rand -hex 32
# ------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------
# 7. BOOTSTRAP INITIAL SYSTEM ADMINISTRATOR
# ------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@smartpay.io
BOOTSTRAP_ADMIN_PASSWORD=Admin@SmartPay2026!

# ------------------------------------------------------------
# 8. MONITORING & METRICS (Prometheus & Grafana)
# ------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
