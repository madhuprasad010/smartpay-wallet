# ============================================================
# SmartPay Wallet — Environment Variables
# Copy to .env and fill in real secrets before running.
# ============================================================

# ----- MySQL 8.4 -----
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307

# Service-specific database credentials
AUTH_DB_NAME=smartpay_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=changeme_auth

USER_DB_NAME=smartpay_users
USER_DB_USER=user_service
USER_DB_PASSWORD=changeme_user

WALLET_DB_NAME=smartpay_wallets
WALLET_DB_USER=wallet_service
WALLET_DB_PASSWORD=changeme_wallet

TRANSACTION_DB_NAME=smartpay_transactions
TRANSACTION_DB_USER=transaction_service
TRANSACTION_DB_PASSWORD=changeme_transaction

PAYMENT_DB_NAME=smartpay_payments
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=changeme_payment

BENEFICIARY_DB_NAME=smartpay_beneficiaries
BENEFICIARY_DB_USER=beneficiary_service
BENEFICIARY_DB_PASSWORD=changeme_beneficiary

NOTIFICATION_DB_NAME=smartpay_notifications
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=changeme_notification

AUDIT_DB_NAME=smartpay_audit
AUDIT_DB_USER=audit_service
AUDIT_DB_PASSWORD=changeme_audit

# ----- Redis 7 -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# ----- Kafka (KRaft) -----
KAFKA_HOST_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ----- RabbitMQ 3 -----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=smartpay
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq

# ----- JWT / Security -----
JWT_SECRET=changeme_jwt_secret_min_32_chars_long_value
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# ----- Service Ports -----
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
WALLET_SERVICE_PORT=8083
TRANSACTION_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
BENEFICIARY_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
AUDIT_SERVICE_PORT=8088

# ----- Frontend -----
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost/api

# ----- Nginx -----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ----- Monitoring -----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana
